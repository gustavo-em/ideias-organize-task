<resources>
    <!-- Official Aluza kit. The system paints the launch window with the same
         cream the in-app splash uses, so the opening never flashes another
         colour or another brand. -->
    <color name="brand_sun">#FFC107</color>
    <color name="brand_ink">#1D1D1B</color>
    <color name="brand_cream">#F6F3EC</color>
    <color name="brand_launch_background">#F6F3EC</color>
    <!-- The launcher icon keeps its light background in both appearances. -->
    <!-- O chão do ícone é o Sol da marca: tocar no ícone e ver a splash
         tem de ser o mesmo gesto continuando. -->
    <color name="brand_icon_background">#FAA805</color>
</resources>
