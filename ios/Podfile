# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# Firebase resolved as pods rather than Swift Package Manager: with SPM every
# react-native-firebase pod embeds its own copy of firebase-ios-sdk, and under
# the static linkage this app builds with those copies collide at link time.
$RNFirebaseDisableSPM = true

target 'IdeiasOrganizeTask' do
  config = use_native_modules!

  # Google Sign-In and the Firebase pods are Swift, and importing them from a
  # static library needs module maps on every interop pod they reach. Turned
  # on for the whole target because the chain (GoogleUtilities, Recaptcha,
  # FirebaseAuthInterop, FirebaseAppCheckInterop, …) keeps growing otherwise.
  use_modular_headers!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
